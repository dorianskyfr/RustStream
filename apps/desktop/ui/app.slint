import { LineEdit, ScrollView, Slider, Spinner, AboutSlint, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import {
    Icon, Button, Card, NavItem, StatusDot, Pill, PageHeader, SectionTitle,
    SettingRow, Divider, Toggle, OptionCard, Dialog, Backdrop, ScreenArt, StatCard
} from "widgets.slint";

export { Theme }

export struct ComputerItem {
    id: string,
    name: string,
    address: string,
    status: string,
    online: bool,
    saved: bool,
    fingerprint: string,
}

export struct TrustedItem {
    id: string,
    name: string,
    fingerprint: string,
    last-seen: string,
}

export struct StatLine {
    label: string,
    value: string,
}

// Stylised monitor with an abstract screen (original artwork, not a capture).
component MonitorArt {
    in property <int> variant;
    private property <length> stand: 34px;
    private property <length> w: min(root.width, (root.height - self.stand) / 0.62);
    private property <length> h: self.w * 0.62;
    private property <length> ox: (root.width - self.w) / 2;
    private property <length> oy: (root.height - self.h - self.stand) / 2;
    accessible-role: none;

    // Glow under the stand
    Rectangle {
        x: root.ox + root.w * 0.12;
        y: root.oy + root.h + 6px;
        width: root.w * 0.76;
        height: 40px;
        background: @radial-gradient(circle, #3b82f699 0%, #a855f700 70%);
    }
    // Neck
    Rectangle {
        x: root.ox + root.w / 2 - root.w * 0.055;
        y: root.oy + root.h - 2px;
        width: root.w * 0.11;
        height: root.stand - 8px;
        background: @linear-gradient(180deg, #1b2646 0%, #0c1328 100%);
    }
    // Base with a cyan → violet light strip
    Rectangle {
        x: root.ox + root.w / 2 - root.w * 0.2;
        y: root.oy + root.h + root.stand - 12px;
        width: root.w * 0.4;
        height: 7px;
        border-radius: 3.5px;
        background: @linear-gradient(90deg, #22d3ee 0%, #3b82f6 50%, #a855f7 100%);
        drop-shadow-blur: 16px;
        drop-shadow-color: #3b82f6aa;
    }
    // Bezel
    Rectangle {
        x: root.ox;
        y: root.oy;
        width: root.w;
        height: root.h;
        border-radius: 10px;
        background: #060a17;
        border-width: 1.5px;
        border-color: #2b3d6b;
        drop-shadow-blur: 34px;
        drop-shadow-color: #3b82f644;
        ScreenArt {
            x: 7px;
            y: 7px;
            width: parent.width - 14px;
            height: parent.height - 14px;
            border-radius: 5px;
            variant: root.variant;
        }
    }
}

// One row of a popup menu.
component MenuRow {
    in property <string> text;
    in property <string> icon;
    in property <bool> danger;
    callback clicked;
    height: 38px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        border-radius: 8px;
        background: ta.has-hover ? Theme.surface-hover : transparent;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 10px;
            Icon {
                data: root.icon;
                color: root.danger ? Theme.danger : Theme.text-muted;
                size: 16px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.text;
                color: root.danger ? Theme.danger : Theme.text;
                font-size: Theme.font-m;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Menu inherits Rectangle {
    background: Theme.surface-solid;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000088;
    VerticalLayout {
        padding: 6px;
        @children
    }
}

component ComputerTile {
    in property <ComputerItem> item;
    in property <int> variant;
    in property <bool> selected;
    callback select();
    callback connect();
    callback remove();

    width: 236px;
    height: 200px;

    Rectangle {
        border-radius: 18px;
        background: root.selected ? @linear-gradient(160deg, #22d3ee22 0%, #3b82f61f 55%, #a855f71f 100%)
            : tile-ta.has-hover ? Theme.surface-hover : Theme.surface;
        border-width: root.selected ? 1.5px : 1px;
        border-color: root.selected ? Theme.cyan.with-alpha(0.75) : Theme.border;
        drop-shadow-blur: root.selected ? 24px : 0px;
        drop-shadow-color: #22d3ee44;
        animate border-color, drop-shadow-blur { duration: Theme.fast; }

        tile-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.select(); }
        }
        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            Rectangle {
                vertical-stretch: 1;
                border-radius: 10px;
                clip: true;
                accessible-role: text;
                accessible-label: root.item.name + ", " + root.item.status;
                ScreenArt {
                    width: parent.width;
                    height: parent.height;
                    variant: root.variant;
                }
                Icon {
                    x: 10px;
                    y: 10px;
                    data: Icons.monitor;
                    color: #ffffffe6;
                    size: 20px;
                }
                StatusDot {
                    x: parent.width - self.width - 11px;
                    y: 12px;
                    tint: root.item.online ? Theme.success : #8a94b0;
                }
                Rectangle {
                    y: parent.height - self.height;
                    height: 32px;
                    background: @linear-gradient(180deg, #00000000 0%, #000000b0 100%);
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: root.item.name;
                        color: #ffffff;
                        font-size: Theme.font-s;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                height: 38px;
                Button {
                    primary: root.selected;
                    icon: Icons.play;
                    icon-filled: true;
                    icon-size: 18px;
                    label: "Se connecter à " + root.item.name;
                    horizontal-stretch: 1;
                    clicked => { root.select(); root.connect(); }
                }
                Button {
                    icon: Icons.dots;
                    icon-size: 20px;
                    label: "Options de " + root.item.name;
                    width: 54px;
                    clicked => { menu.show(); }
                }
            }
        }
        menu := PopupWindow {
            x: parent.width - 190px;
            y: parent.height - 6px;
            width: 200px;
            Menu {
                MenuRow {
                    text: "Se connecter";
                    icon: Icons.play;
                    clicked => { menu.close(); root.select(); root.connect(); }
                }
                if root.item.saved: MenuRow {
                    text: "Retirer de la liste";
                    icon: Icons.trash;
                    danger: true;
                    clicked => { menu.close(); root.remove(); }
                }
            }
        }
    }
}

component AddTile {
    callback clicked;
    width: 180px;
    height: 200px;
    accessible-role: button;
    accessible-label: "Ajouter un ordinateur";
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;
    Rectangle {
        border-radius: 18px;
        background: ta.has-hover ? Theme.surface-hover : Theme.surface;
        border-width: fs.has-focus ? 2px : 1px;
        border-color: fs.has-focus ? Theme.focus : ta.has-hover ? Theme.violet.with-alpha(0.7) : Theme.border;
        animate border-color { duration: Theme.fast; }
        Icon {
            data: Icons.plus;
            color: Theme.text;
            size: 40px;
            weight: 1.6px;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { fs.focus(); root.clicked(); }
    }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

// Computer picker: shows the selected computer, opens a list on click.
component ComputerPicker {
    in property <[ComputerItem]> computers;
    in-out property <int> selected;
    private property <bool> has: root.computers.length > 0;

    height: 56px;
    accessible-role: combobox;
    accessible-label: "Ordinateur";
    accessible-value: root.has ? root.computers[root.selected].name : "Aucun ordinateur";
    forward-focus: fs;

    Rectangle {
        border-radius: 12px;
        background: ta.has-hover && root.has ? Theme.surface-hover : #0a1124f0;
        border-width: fs.has-focus ? 2px : 1px;
        border-color: fs.has-focus ? Theme.focus : Theme.border-strong;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 14px;
            spacing: 14px;
            Icon {
                data: Icons.monitor;
                color: Theme.text-muted;
                size: 22px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.has ? root.computers[root.selected].name : "Aucun ordinateur";
                    color: root.has ? Theme.text : Theme.text-muted;
                    font-size: Theme.font-l;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.has: Text {
                    text: root.computers[root.selected].status + " · " + root.computers[root.selected].address;
                    color: Theme.text-faint;
                    font-size: Theme.font-xs;
                    overflow: elide;
                }
            }
            Icon {
                data: Icons.chevron-down;
                color: root.has ? Theme.text : Theme.text-faint;
                size: 20px;
                y: (parent.height - self.height) / 2;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: root.has ? pointer : default;
        clicked => {
            fs.focus();
            if (root.has) { popup.show(); }
        }
    }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow && root.selected > 0) {
                root.selected -= 1;
                return accept;
            }
            if (event.text == Key.DownArrow && root.selected < root.computers.length - 1) {
                root.selected += 1;
                return accept;
            }
            if ((event.text == Key.Return || event.text == " ") && root.has) {
                popup.show();
                return accept;
            }
            reject
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        Menu {
            for c[i] in root.computers: Rectangle {
                height: 46px;
                border-radius: 8px;
                background: row-ta.has-hover ? Theme.surface-hover : i == root.selected ? Theme.accent-soft : transparent;
                accessible-role: button;
                accessible-label: c.name;
                accessible-action-default => { root.selected = i; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    StatusDot {
                        tint: c.online ? Theme.success : #8a94b0;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: c.name;
                        color: Theme.text;
                        font-size: Theme.font-m;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: c.status;
                        color: Theme.text-faint;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                }
                row-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.selected = i; popup.close(); }
                }
            }
        }
    }
}

component ShareCard inherits Card {
    in property <bool> hosting;
    in property <string> local-address;
    in property <string> host-session-peer;
    callback set-hosting(bool);
    callback stop-host-session();
    min-height: 92px;
    HorizontalLayout {
        padding: 16px;
        spacing: 14px;
        Rectangle {
            width: 42px;
            height: 42px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Theme.accent-soft;
            Icon {
                data: Icons.server;
                color: Theme.accent-gradient;
                size: 22px;
                weight: 2px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.host-session-peer != "" ? "Session en cours avec" : "Partager cet ordinateur";
                color: root.host-session-peer != "" ? Theme.warning : Theme.text-muted;
                font-size: Theme.font-s;
                overflow: elide;
            }
            Text {
                text: root.host-session-peer != "" ? root.host-session-peer
                    : root.hosting ? root.local-address : "Désactivé";
                color: Theme.text;
                font-size: Theme.font-m;
                font-weight: 700;
                overflow: elide;
            }
            // Status strip: full gradient when sharing (not a progress bar).
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.surface-2;
                Rectangle {
                    x: 0;
                    width: root.hosting ? parent.width : 0px;
                    border-radius: 2px;
                    background: @linear-gradient(90deg, #22d3ee 0%, #3b82f6 60%, #a855f7 100%);
                    animate width { duration: Theme.normal; easing: ease-out; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            if root.host-session-peer != "": Button {
                text: "Terminer";
                danger: true;
                clicked => { root.stop-host-session(); }
            }
            if root.host-session-peer == "": Toggle {
                label: "Partager cet ordinateur";
                checked: root.hosting;
                toggled(v) => { root.set-hosting(v); }
            }
        }
    }
}

component HomePage {
    in property <string> device-name;
    in property <string> fingerprint;
    in property <string> local-address;
    in property <bool> hosting;
    in property <string> host-session-peer;
    in property <[ComputerItem]> computers;
    in-out property <int> selected;
    in property <string> net-value;
    in property <string> net-spark;
    in property <string> latency-value;
    in property <string> latency-spark;
    callback set-hosting(bool);
    callback stop-host-session();
    callback connect(string);
    callback remove-computer(string);
    callback open-add();

    private property <bool> has: root.computers.length > 0;
    private property <int> sel: max(0, min(root.selected, root.computers.length - 1));

    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 26px;
        padding-bottom: 26px;
        spacing: 28px;
        alignment: start;

        // Wordmark
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            height: 52px;
            accessible-role: text;
            accessible-label: "RustStream";
            Path {
                width: 40px;
                height: 40px;
                y: (parent.height - self.height) / 2;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M6.5 3.6 C6.5 2.5 7.7 1.9 8.6 2.5 L20.6 10.5 C21.4 11.1 21.4 12.9 20.6 13.5 L8.6 21.5 C7.7 22.1 6.5 21.5 6.5 20.4 Z M10 8.2 V15.8 L15.6 12 Z";
                fill: @linear-gradient(135deg, #22d3ee 0%, #3b82f6 50%, #a855f7 100%);
                stroke: transparent;
            }
            HorizontalLayout {
                spacing: 0px;
                Text {
                    text: "rust";
                    color: Theme.text;
                    font-size: 34px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: "stream";
                    color: #38bdf8;
                    font-size: 34px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 22px;
            height: max(280px, min(400px, root.height - 410px));

            // Hero
            Card {
                horizontal-stretch: 1;
                border-radius: 24px;
                border-width: 1.5px;
                border-color: Theme.blue.with-alpha(0.5);
                drop-shadow-blur: 30px;
                drop-shadow-color: #3b82f622;
                HorizontalLayout {
                    padding: 24px;
                    padding-left: 30px;
                    padding-right: 34px;
                    spacing: 34px;
                    MonitorArt {
                        horizontal-stretch: 1;
                        min-width: 200px;
                        variant: root.has ? Math.mod(root.sel, 4) : 0;
                    }
                    VerticalLayout {
                        width: 320px;
                        alignment: center;
                        spacing: 18px;
                        ComputerPicker {
                            computers: root.computers;
                            selected <=> root.selected;
                        }
                        if root.has: Button {
                            primary: true;
                            icon: Icons.play;
                            icon-filled: true;
                            icon-size: 28px;
                            label: "Se connecter à " + root.computers[root.sel].name;
                            height: 64px;
                            clicked => { root.connect(root.computers[root.sel].id); }
                        }
                        if !root.has: Button {
                            primary: true;
                            icon: Icons.plus;
                            text: "Ajouter un ordinateur";
                            height: 64px;
                            clicked => { root.open-add(); }
                        }
                        Text {
                            text: root.has ? "Se connecter à " + root.computers[root.sel].name
                                : "Activez « Partager » sur l'autre ordinateur : il apparaîtra ici.";
                            color: Theme.text-faint;
                            font-size: Theme.font-s;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Live status
            VerticalLayout {
                width: 310px;
                spacing: 16px;
                StatCard {
                    icon: Icons.signal;
                    title: "Débit vidéo";
                    value: root.net-value;
                    spark: root.net-spark;
                }
                StatCard {
                    icon: Icons.gauge;
                    title: "Latence réseau";
                    value: root.latency-value;
                    spark: root.latency-spark;
                }
                ShareCard {
                    hosting: root.hosting;
                    local-address: root.local-address;
                    host-session-peer: root.host-session-peer;
                    set-hosting(v) => { root.set-hosting(v); }
                    stop-host-session => { root.stop-host-session(); }
                }
            }
        }

        // Computers
        Flickable {
            height: 214px;
            content-width: tiles.preferred-width;
            tiles := HorizontalLayout {
                height: 214px;
                padding: 7px;
                spacing: 20px;
                alignment: start;
                for c[i] in root.computers: ComputerTile {
                    item: c;
                    variant: Math.mod(i, 4);
                    selected: i == root.sel;
                    select => { root.selected = i; }
                    connect => { root.connect(c.id); }
                    remove => { root.remove-computer(c.id); }
                }
                AddTile {
                    clicked => { root.open-add(); }
                }
            }
        }
    }
}

component InfoCard inherits Card {
    in property <string> title;
    in property <string> description;
    in property <string> icon;
    in property <string> status;
    in property <color> status-color: Theme.text-faint;
    HorizontalLayout {
        padding: 16px;
        spacing: 14px;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: Theme.radius-s;
            background: Theme.surface-2;
            Icon { data: root.icon; color: Theme.text-muted; size: 20px; }
        }
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-m;
                font-weight: 600;
            }
            Text {
                text: root.description;
                color: Theme.text-muted;
                font-size: Theme.font-s;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: start;
            Pill { text: root.status; tint: root.status-color; }
        }
    }
}

component DevicesPage {
    sv := ScrollView {
        width: root.width;
        height: root.height;
        VerticalLayout {
            width: sv.visible-width;
            padding: 28px;
            padding-top: 24px;
            spacing: 14px;
            alignment: start;
            PageHeader {
                title: "Périphériques";
                subtitle: "Ce qui est transmis à l'ordinateur distant pendant une session.";
            }
            InfoCard {
                title: "Clavier et souris";
                icon: Icons.keyboard;
                status: "Actif en session";
                status-color: Theme.success;
                description: "Les touches sont envoyées par code matériel : la disposition du clavier distant s'applique. Le clavier est capturé uniquement quand la fenêtre RustStream est au premier plan. Ctrl+Alt+Maj+Q rend le clavier à cet ordinateur.";
            }
            InfoCard {
                title: "Manettes";
                icon: Icons.devices;
                status: "Pas encore disponible";
                description: "La prise en charge des manettes est prévue dans une prochaine version (phase 3 de la feuille de route).";
            }
            InfoCard {
                title: "Redirection USB";
                icon: Icons.usb;
                status: "Pas encore disponible";
                description: "La redirection de périphériques USB (clés, imprimantes, webcams…) est prévue en phase 4. Aucun périphérique n'est partagé, et rien ne le sera sans votre autorisation explicite pour chaque appareil.";
            }
        }
    }
}

component PerformancePage {
    in-out property <int> profile;
    in-out property <bool> advanced;
    in-out property <int> adv-fps;
    in-out property <int> adv-bitrate;
    in property <[string]> gpus;
    in property <string> encoder-text;
    in property <[StatLine]> stats;
    in property <string> stats-title;
    callback set-profile(int);
    callback set-advanced(bool, int, int);

    sv := ScrollView {
        width: root.width;
        height: root.height;
        VerticalLayout {
            width: sv.visible-width;
            padding: 28px;
            padding-top: 24px;
            spacing: 18px;
            alignment: start;
            PageHeader {
                title: "Performances";
                subtitle: "Choisissez un profil : RustStream règle le reste.";
            }
            HorizontalLayout {
                spacing: 12px;
                OptionCard {
                    title: "Automatique";
                    description: "Bon équilibre pour la plupart des usages. 60 i/s, 20 Mbit/s.";
                    icon: Icons.check;
                    selected: !root.advanced && root.profile == 0;
                    clicked => { root.set-profile(0); }
                }
                OptionCard {
                    title: "Performance";
                    description: "Priorité à la réactivité. Jusqu'à 120 i/s, 15 Mbit/s.";
                    icon: Icons.performance;
                    selected: !root.advanced && root.profile == 1;
                    clicked => { root.set-profile(1); }
                }
                OptionCard {
                    title: "Qualité";
                    description: "Priorité à l'image. 60 i/s, 40 Mbit/s.";
                    icon: Icons.monitor;
                    selected: !root.advanced && root.profile == 2;
                    clicked => { root.set-profile(2); }
                }
            }
            Card {
                VerticalLayout {
                    SettingRow {
                        title: "Mode avancé";
                        description: "Fixer vous-même la fréquence d'images et le débit. La fréquence reste limitée par l'écran de l'ordinateur distant.";
                        Toggle {
                            label: "Mode avancé";
                            checked: root.advanced;
                            toggled(v) => { root.set-advanced(v, root.adv-fps, root.adv-bitrate); }
                        }
                    }
                    if root.advanced: Divider { }
                    if root.advanced: SettingRow {
                        title: "Images par seconde";
                        HorizontalLayout {
                            spacing: 6px;
                            for f in [30, 60, 120, 144, 165, 240]: Button {
                                text: f;
                                primary: root.adv-fps == f;
                                clicked => {
                                    root.adv-fps = f;
                                    root.set-advanced(true, root.adv-fps, root.adv-bitrate);
                                }
                            }
                        }
                    }
                    if root.advanced: Divider { }
                    if root.advanced: SettingRow {
                        title: "Débit vidéo";
                        description: root.adv-bitrate + " Mbit/s";
                        Slider {
                            width: 220px;
                            minimum: 2;
                            maximum: 150;
                            value: root.adv-bitrate;
                            changed(v) => {
                                root.adv-bitrate = round(v);
                                root.set-advanced(true, root.adv-fps, root.adv-bitrate);
                            }
                        }
                    }
                }
            }
            SectionTitle { text: "MATÉRIEL"; }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    for g in root.gpus: Text {
                        text: g;
                        color: Theme.text;
                        font-size: Theme.font-m;
                    }
                    Text {
                        text: root.encoder-text;
                        color: Theme.text-muted;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                    }
                }
            }
            SectionTitle { text: root.stats-title; }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    if root.stats.length == 0: Text {
                        text: "Les statistiques s'affichent pendant une session.";
                        color: Theme.text-muted;
                        font-size: Theme.font-s;
                    }
                    for s in root.stats: HorizontalLayout {
                        Text {
                            text: s.label;
                            color: Theme.text-muted;
                            font-size: Theme.font-s;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: s.value;
                            color: Theme.text;
                            font-size: Theme.font-s;
                            font-weight: 600;
                        }
                    }
                }
            }
        }
    }
}

component SettingsPage {
    in property <bool> hosting;
    in property <bool> allow-pairing;
    in property <int> port;
    in property <[TrustedItem]> trusted;
    in property <string> device-name;
    in property <string> fingerprint-full;
    in property <bool> dark;
    in property <bool> animations;
    callback set-hosting(bool);
    callback set-allow-pairing(bool);
    callback revoke(string);
    callback rename-device(string);
    callback set-dark(bool);
    callback set-animations(bool);

    sv := ScrollView {
        width: root.width;
        height: root.height;
        VerticalLayout {
            width: sv.visible-width;
            padding: 28px;
            padding-top: 24px;
            spacing: 14px;
            alignment: start;
            PageHeader {
                title: "Paramètres";
            }

            SectionTitle { text: "PARTAGE ET SÉCURITÉ"; }
            Card {
                VerticalLayout {
                    SettingRow {
                        title: "Autoriser les connexions";
                        description: "Port UDP " + root.port + ". Rien n'est exposé sur le réseau tant que c'est désactivé.";
                        Toggle {
                            label: "Autoriser les connexions";
                            checked: root.hosting;
                            toggled(v) => { root.set-hosting(v); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "Accepter de nouveaux appareils";
                        description: "Chaque nouvel appareil doit être approuvé ici, après vérification d'un code à 6 chiffres affiché sur les deux écrans.";
                        Toggle {
                            label: "Accepter de nouveaux appareils";
                            checked: root.allow-pairing;
                            toggled(v) => { root.set-allow-pairing(v); }
                        }
                    }
                }
            }

            SectionTitle { text: "APPAREILS AUTORISÉS À SE CONNECTER"; }
            Card {
                VerticalLayout {
                    if root.trusted.length == 0: HorizontalLayout {
                        padding-left: 16px;
                        height: 48px;
                        Text {
                            text: "Aucun appareil autorisé.";
                            color: Theme.text-muted;
                            font-size: Theme.font-s;
                            vertical-alignment: center;
                        }
                    }
                    for t[i] in root.trusted: VerticalLayout {
                        if i > 0: Divider { }
                        SettingRow {
                            title: t.name;
                            description: t.fingerprint + " · " + t.last-seen;
                            Button {
                                text: "Révoquer";
                                quiet: true;
                                clicked => { root.revoke(t.id); }
                            }
                        }
                    }
                }
            }

            SectionTitle { text: "IDENTITÉ"; }
            Card {
                VerticalLayout {
                    SettingRow {
                        title: "Nom de cet ordinateur";
                        description: "Visible par les autres appareils.";
                        name-edit := LineEdit {
                            width: 220px;
                            text: root.device-name;
                            accessible-label: "Nom de cet ordinateur";
                            accepted(text) => { root.rename-device(text); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "Empreinte de l'appareil";
                        description: root.fingerprint-full;
                    }
                }
            }

            SectionTitle { text: "APPARENCE"; }
            Card {
                VerticalLayout {
                    SettingRow {
                        title: "Mode sombre";
                        Toggle {
                            label: "Mode sombre";
                            checked: root.dark;
                            toggled(v) => { root.set-dark(v); }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "Animations";
                        description: "Transitions courtes de l'interface.";
                        Toggle {
                            label: "Animations";
                            checked: root.animations;
                            toggled(v) => { root.set-animations(v); }
                        }
                    }
                }
            }

            SectionTitle { text: "À PROPOS"; }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: "RustStream 0.1.0 — préversion de développement";
                        color: Theme.text;
                        font-size: Theme.font-m;
                        font-weight: 600;
                    }
                    Text {
                        text: "Logiciel libre, licence MIT ou Apache-2.0. Encodage vidéo actuel : OpenH264 (logiciel). Aucune télémétrie : les statistiques restent sur cet ordinateur.";
                        color: Theme.text-muted;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        AboutSlint { max-width: 220px; }
                    }
                }
            }
        }
    }
}

component SessionView inherits Rectangle {
    in property <image> frame;
    in property <int> stream-width;
    in property <int> stream-height;
    in property <string> session-title;
    in property <[StatLine]> stats;
    in property <[string]> remote-displays;
    in property <int> remote-display;
    in property <bool> fullscreen;
    in property <bool> capture-paused;
    in-out property <bool> show-stats;
    in property <bool> waiting;
    callback disconnect();
    callback toggle-fullscreen();
    callback select-display(int);
    callback pointer(float, float);
    callback button(int, bool);
    callback wheel(float, float);
    callback resume-capture();

    background: #000000;
    private property <float> sw: max(1, root.stream-width);
    private property <float> sh: max(1, root.stream-height);
    private property <float> fit: min(root.width / 1px / sw, root.height / 1px / sh);
    private property <bool> toolbar-visible: root.waiting || root.capture-paused || bar-ta.has-hover
        || top-ta.has-hover
        || (stream-ta.has-hover && stream-ta.mouse-y + img.y < 64px);

    img := Image {
        source: root.frame;
        width: root.sw * root.fit * 1px;
        height: root.sh * root.fit * 1px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        image-fit: fill;
        accessible-role: image;
        accessible-label: "Écran distant";
    }

    stream-ta := TouchArea {
        x: img.x;
        y: img.y;
        width: img.width;
        height: img.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) {
                root.pointer(self.mouse-x / self.width, self.mouse-y / self.height);
            } else if (e.kind == PointerEventKind.down || e.kind == PointerEventKind.up) {
                if (root.capture-paused && e.kind == PointerEventKind.down) {
                    root.resume-capture();
                }
                root.pointer(self.mouse-x / self.width, self.mouse-y / self.height);
                root.button(
                    e.button == PointerEventButton.left ? 0
                        : e.button == PointerEventButton.right ? 1
                        : e.button == PointerEventButton.middle ? 2
                        : e.button == PointerEventButton.back ? 3
                        : e.button == PointerEventButton.forward ? 4 : -1,
                    e.kind == PointerEventKind.down);
            }
        }
        scroll-event(e) => {
            root.wheel(e.delta-x / 1px, e.delta-y / 1px);
            accept
        }
    }

    // Hover target above a letterboxed image, so the toolbar can always be
    // revealed by moving the pointer to the top edge.
    top-ta := TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: max(img.y, 0px);
    }

    if root.waiting: VerticalLayout {
        alignment: center;
        spacing: 12px;
        Spinner {
            indeterminate: true;
            width: 32px;
            height: 32px;
            x: (parent.width - self.width) / 2;
        }
        Text {
            text: "En attente de l'image…";
            color: #c8ccd4;
            font-size: Theme.font-m;
            horizontal-alignment: center;
        }
    }

    // Auto-hiding control bar.
    bar := Rectangle {
        y: root.toolbar-visible ? 12px : -self.height - 4px;
        x: (root.width - self.width) / 2;
        width: bar-layout.preferred-width;
        height: 44px;
        background: #16181dee;
        border-radius: 12px;
        border-width: 1px;
        border-color: #2a2e37;
        animate y { duration: Theme.normal; easing: ease-out; }
        bar-ta := TouchArea { }
        bar-layout := HorizontalLayout {
            padding: 5px;
            padding-left: 12px;
            spacing: 4px;
            Text {
                text: root.session-title;
                color: #e9ebef;
                font-size: Theme.font-s;
                font-weight: 600;
                vertical-alignment: center;
                max-width: 240px;
                overflow: elide;
            }
            Rectangle { width: 8px; }
            for d[i] in root.remote-displays: Button {
                text: d;
                quiet: i != root.remote-display;
                primary: i == root.remote-display;
                clicked => { root.select-display(i); }
            }
            Button {
                icon: Icons.stats;
                label: "Statistiques";
                quiet: !root.show-stats;
                clicked => { root.show-stats = !root.show-stats; }
            }
            Button {
                icon: Icons.fullscreen;
                label: root.fullscreen ? "Quitter le plein écran" : "Plein écran";
                quiet: true;
                clicked => { root.toggle-fullscreen(); }
            }
            Button {
                text: "Déconnecter";
                icon: Icons.power;
                danger: true;
                clicked => { root.disconnect(); }
            }
        }
    }

    if root.capture-paused: Rectangle {
        y: root.height - 56px;
        x: (root.width - self.width) / 2;
        width: hint.preferred-width + 28px;
        height: 36px;
        border-radius: 18px;
        background: #16181dee;
        hint := Text {
            text: "Clavier rendu à cet ordinateur — cliquez sur l'image pour le capturer à nouveau";
            color: #e9ebef;
            font-size: Theme.font-s;
        }
    }

    if root.show-stats: Rectangle {
        x: root.width - self.width - 12px;
        y: 64px;
        width: 250px;
        height: stats-layout.preferred-height;
        background: #0d0e11dd;
        border-radius: 10px;
        stats-layout := VerticalLayout {
            padding: 12px;
            spacing: 4px;
            for s in root.stats: HorizontalLayout {
                Text {
                    text: s.label;
                    color: #959ba6;
                    font-size: Theme.font-xs;
                    horizontal-stretch: 1;
                }
                Text {
                    text: s.value;
                    color: #e9ebef;
                    font-size: Theme.font-xs;
                    font-weight: 600;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: root.in-session ? root.session-title + " — RustStream" : "RustStream";
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 980px;
    min-height: 640px;
    background: root.in-session ? #000000 : Theme.bg;
    default-font-family: "Segoe UI";
    icon: @image-url("../assets/icon.png");

    in-out property <bool> dark <=> Theme.dark;
    in-out property <bool> animations <=> Theme.animations;
    in-out property <int> page: 0;
    in-out property <int> selected-computer: 0;
    // Home status cards (sparklines: SVG path on a 100×30 viewbox).
    in property <string> net-value: "—";
    in property <string> net-spark;
    in property <string> latency-value: "—";
    in property <string> latency-spark;

    // Local computer
    in property <string> device-name;
    in property <string> fingerprint;
    in property <string> fingerprint-full;
    in property <string> local-address;
    in property <bool> hosting;
    in property <bool> allow-pairing;
    in property <int> port;
    in property <string> host-session-peer;
    in property <[ComputerItem]> computers;
    in property <[TrustedItem]> trusted;

    // Performance
    in-out property <int> profile;
    in-out property <bool> advanced;
    in-out property <int> adv-fps: 60;
    in-out property <int> adv-bitrate: 20;
    in property <[string]> gpus;
    in property <string> encoder-text;
    in property <[StatLine]> stats;
    in property <string> stats-title: "STATISTIQUES";

    // Session
    in property <bool> in-session;
    in property <bool> waiting-frame;
    in property <image> frame;
    in property <int> stream-width: 16;
    in property <int> stream-height: 9;
    in property <string> session-title;
    in property <[string]> remote-displays;
    in property <int> remote-display;
    in property <bool> fullscreen;
    in property <bool> capture-paused;
    in-out property <bool> show-stats;

    // Overlays
    in property <bool> connecting;
    in property <string> connecting-text;
    in property <string> client-code;
    in property <string> host-request-name;
    in property <string> host-request-code;
    in property <string> error-text;
    in-out property <bool> add-open;

    callback connect(string);
    callback remove-computer(string);
    callback add-computer(string);
    callback set-hosting(bool);
    callback set-allow-pairing(bool);
    callback stop-host-session();
    callback revoke(string);
    callback rename-device(string);
    callback set-dark(bool);
    callback set-animations(bool);
    callback set-profile(int);
    callback set-advanced(bool, int, int);
    callback cancel-connect();
    callback confirm-pairing(bool);
    callback answer-pairing(bool);
    callback disconnect();
    callback toggle-fullscreen();
    callback select-display(int);
    callback dismiss-error();
    callback stream-pointer(float, float);
    callback stream-button(int, bool);
    callback stream-wheel(float, float);
    callback resume-capture();
    callback apply-theme();

    apply-theme => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => { root.apply-theme(); }

    if !root.in-session: Backdrop {
        width: parent.width;
        height: parent.height;
    }

    // Content (declared before the sidebar so the sidebar tooltips draw on top).
    if !root.in-session: Rectangle {
        x: 112px;
        width: parent.width - self.x;
        height: parent.height;
        if root.page == 0: HomePage {
            width: parent.width;
            height: parent.height;
            device-name: root.device-name;
            fingerprint: root.fingerprint;
            local-address: root.local-address;
            hosting: root.hosting;
            host-session-peer: root.host-session-peer;
            computers: root.computers;
            selected <=> root.selected-computer;
            net-value: root.net-value;
            net-spark: root.net-spark;
            latency-value: root.latency-value;
            latency-spark: root.latency-spark;
            set-hosting(v) => { root.set-hosting(v); }
            stop-host-session => { root.stop-host-session(); }
            connect(id) => { root.connect(id); }
            remove-computer(id) => { root.remove-computer(id); }
            open-add => { root.add-open = true; }
        }
        if root.page == 1: DevicesPage {
            width: parent.width;
            height: parent.height;
        }
        if root.page == 2: PerformancePage {
            width: parent.width;
            height: parent.height;
            profile <=> root.profile;
            advanced <=> root.advanced;
            adv-fps <=> root.adv-fps;
            adv-bitrate <=> root.adv-bitrate;
            gpus: root.gpus;
            encoder-text: root.encoder-text;
            stats: root.stats;
            stats-title: root.stats-title;
            set-profile(p) => { root.set-profile(p); }
            set-advanced(a, f, b) => { root.set-advanced(a, f, b); }
        }
        if root.page == 3: SettingsPage {
            width: parent.width;
            height: parent.height;
            hosting: root.hosting;
            allow-pairing: root.allow-pairing;
            port: root.port;
            trusted: root.trusted;
            device-name: root.device-name;
            fingerprint-full: root.fingerprint-full;
            dark: root.dark;
            animations: root.animations;
            set-hosting(v) => { root.set-hosting(v); }
            set-allow-pairing(v) => { root.set-allow-pairing(v); }
            revoke(id) => { root.revoke(id); }
            rename-device(n) => { root.rename-device(n); }
            set-dark(v) => { root.set-dark(v); }
            set-animations(v) => { root.set-animations(v); }
        }
    }

    // Icon-only glass sidebar.
    if !root.in-session: Rectangle {
        x: 14px;
        y: 14px;
        width: 84px;
        height: parent.height - 28px;
        background: Theme.sidebar;
        border-radius: 22px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000066;
        VerticalLayout {
            padding: 14px;
            padding-top: 24px;
            padding-bottom: 18px;
            spacing: 14px;
            NavItem {
                text: "Accueil";
                icon: Icons.home;
                selected: root.page == 0;
                clicked => { root.page = 0; }
            }
            NavItem {
                text: "Périphériques";
                icon: Icons.devices;
                selected: root.page == 1;
                clicked => { root.page = 1; }
            }
            NavItem {
                text: "Performances";
                icon: Icons.performance;
                selected: root.page == 2;
                clicked => { root.page = 2; }
            }
            NavItem {
                text: "Paramètres";
                icon: Icons.settings;
                selected: root.page == 3;
                clicked => { root.page = 3; }
            }
            Rectangle { vertical-stretch: 1; }
            // Sharing status; opens Settings where sharing is configured.
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 16px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                NavItem {
                    text: root.host-session-peer != "" ? "Session en cours" : root.hosting ? "Partage actif · " + root.local-address : "Partage désactivé";
                    icon: Icons.broadcast;
                    clicked => { root.page = 3; }
                }
                StatusDot {
                    x: parent.width - 16px;
                    y: 8px;
                    tint: root.host-session-peer != "" ? Theme.warning : root.hosting ? Theme.success : #8a94b0;
                }
            }
        }
    }

    if root.in-session: SessionView {
        width: parent.width;
        height: parent.height;
        frame: root.frame;
        stream-width: root.stream-width;
        stream-height: root.stream-height;
        session-title: root.session-title;
        stats: root.stats;
        remote-displays: root.remote-displays;
        remote-display: root.remote-display;
        fullscreen: root.fullscreen;
        capture-paused: root.capture-paused;
        show-stats <=> root.show-stats;
        waiting: root.waiting-frame;
        disconnect => { root.disconnect(); }
        toggle-fullscreen => { root.toggle-fullscreen(); }
        select-display(i) => { root.select-display(i); }
        pointer(x, y) => { root.stream-pointer(x, y); }
        button(b, d) => { root.stream-button(b, d); }
        wheel(dx, dy) => { root.stream-wheel(dx, dy); }
        resume-capture => { root.resume-capture(); }
    }

    // Error banner.
    if root.error-text != "": Rectangle {
        y: root.height - self.height - 16px;
        x: (root.width - self.width) / 2;
        width: min(560px, root.width - 32px);
        height: err-layout.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-m;
        border-width: 1px;
        border-color: Theme.danger;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000044;
        accessible-role: text;
        accessible-label: root.error-text;
        err-layout := HorizontalLayout {
            padding: 10px;
            padding-left: 16px;
            spacing: 12px;
            StatusDot { tint: Theme.danger; y: (parent.height - self.height) / 2; }
            Text {
                text: root.error-text;
                color: Theme.text;
                font-size: Theme.font-s;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                icon: Icons.close;
                label: "Fermer";
                quiet: true;
                clicked => { root.dismiss-error(); }
            }
        }
    }

    if root.add-open: Dialog {
        title: "Ajouter un ordinateur";
        Text {
            text: "Saisissez l'adresse IP ou le nom de l'ordinateur sur lequel « Partager » est activé.";
            color: Theme.text-muted;
            font-size: Theme.font-s;
            wrap: word-wrap;
        }
        address := LineEdit {
            placeholder-text: "ex. 192.168.1.20";
            accessible-label: "Adresse de l'ordinateur";
            accepted(text) => {
                root.add-open = false;
                root.add-computer(text);
            }
            init => { self.focus(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Annuler";
                clicked => { root.add-open = false; }
            }
            Button {
                text: "Se connecter";
                primary: true;
                enabled: address.text != "";
                clicked => {
                    root.add-open = false;
                    root.add-computer(address.text);
                }
            }
        }
    }

    if root.connecting && root.client-code == "": Dialog {
        title: root.connecting-text;
        HorizontalLayout {
            spacing: 12px;
            Spinner {
                indeterminate: true;
                width: 22px;
                height: 22px;
            }
            Text {
                text: "Établissement d'une connexion chiffrée…";
                color: Theme.text-muted;
                font-size: Theme.font-s;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Annuler";
                clicked => { root.cancel-connect(); }
            }
        }
    }

    if root.client-code != "": Dialog {
        title: "Vérifiez le code";
        Text {
            text: "L'ordinateur distant affiche un code. Il doit être identique à celui-ci ; autorisez ensuite la connexion sur l'ordinateur distant.";
            color: Theme.text-muted;
            font-size: Theme.font-s;
            wrap: word-wrap;
        }
        Text {
            text: root.client-code;
            color: Theme.text;
            font-size: 36px;
            font-weight: 700;
            letter-spacing: 4px;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: "Code de vérification " + root.client-code;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Les codes diffèrent";
                clicked => { root.confirm-pairing(false); }
            }
            Button {
                text: "Les codes sont identiques";
                primary: true;
                clicked => { root.confirm-pairing(true); }
            }
        }
    }

    if root.host-request-code != "": Dialog {
        title: "Nouvelle demande de connexion";
        Text {
            text: "« " + root.host-request-name + " » souhaite se connecter et contrôler cet ordinateur.";
            color: Theme.text;
            font-size: Theme.font-m;
            wrap: word-wrap;
        }
        Text {
            text: root.host-request-code;
            color: Theme.text;
            font-size: 36px;
            font-weight: 700;
            letter-spacing: 4px;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: "Code de vérification " + root.host-request-code;
        }
        HorizontalLayout {
            spacing: 8px;
            Icon { data: Icons.shield; color: Theme.warning; size: 16px; }
            Text {
                text: "N'autorisez que si l'autre appareil affiche ce même code.";
                color: Theme.text-muted;
                font-size: Theme.font-s;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Refuser";
                clicked => { root.answer-pairing(false); }
            }
            Button {
                text: "Autoriser";
                primary: true;
                clicked => { root.answer-pairing(true); }
            }
        }
    }
}
