// RustStream design tokens: deep navy, glass surfaces, cyan → blue → violet accents.

export global Theme {
    in-out property <bool> dark: true;
    in-out property <bool> animations: true;

    out property <color> bg: dark ? #060914 : #eef2fb;
    out property <color> sidebar: dark ? #0a1022e6 : #ffffffd9;
    // Glass surfaces are translucent so the backdrop glows show through.
    out property <color> surface: dark ? #0d1630e0 : #ffffffe6;
    out property <color> surface-hover: dark ? #142040eb : #f4f7fff0;
    out property <color> surface-2: dark ? #18233fcc : #e6ecf8;
    out property <color> surface-solid: dark ? #0e1528 : #ffffff;
    out property <color> border: dark ? #26355c : #d3dcef;
    out property <color> border-strong: dark ? #34477a : #b9c6e3;
    out property <color> text: dark ? #eef3ff : #0d1424;
    out property <color> text-muted: dark ? #9aa8c7 : #4a5774;
    out property <color> text-faint: dark ? #64739a : #8090b0;

    out property <color> cyan: #22d3ee;
    out property <color> blue: #3b82f6;
    out property <color> violet: #a855f7;
    out property <color> accent: dark ? #3b9cff : #2563eb;
    out property <color> accent-hover: dark ? #5bb0ff : #1d4ed8;
    out property <color> accent-soft: dark ? #3b82f626 : #2563eb1a;
    out property <brush> accent-gradient: @linear-gradient(90deg, #22d3ee 0%, #3b82f6 55%, #a855f7 100%);
    out property <brush> glow-border: @linear-gradient(135deg, #22d3eecc 0%, #3b82f699 45%, #a855f7cc 100%);
    out property <color> on-accent: #ffffff;

    out property <color> success: dark ? #34d399 : #059669;
    out property <color> warning: dark ? #fbbf24 : #b45309;
    out property <color> danger: dark ? #fb7185 : #e11d48;
    out property <color> focus: #22d3ee;
    out property <color> scrim: dark ? #02040acc : #0f172a73;

    out property <length> radius-s: 8px;
    out property <length> radius-m: 14px;
    out property <length> radius-l: 20px;

    out property <length> font-xs: 11px;
    out property <length> font-s: 12px;
    out property <length> font-m: 13px;
    out property <length> font-l: 15px;
    out property <length> font-xl: 20px;
    out property <length> font-xxl: 26px;

    out property <duration> fast: animations ? 140ms : 0ms;
    out property <duration> normal: animations ? 220ms : 0ms;
}

// Vector icons drawn on a 24×24 grid (original artwork, stroke style).
