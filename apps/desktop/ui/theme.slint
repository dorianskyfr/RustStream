// RustStream design tokens. Neutral palette, one discreet blue accent.

export global Theme {
    in-out property <bool> dark: true;
    in-out property <bool> animations: true;

    out property <color> bg: dark ? #0d0e11 : #f5f6f8;
    out property <color> sidebar: dark ? #111317 : #eceef2;
    out property <color> surface: dark ? #16181d : #ffffff;
    out property <color> surface-hover: dark ? #1c1f25 : #f3f4f7;
    out property <color> surface-2: dark ? #20232a : #eef0f3;
    out property <color> border: dark ? #262a32 : #e1e4e9;
    out property <color> text: dark ? #e9ebef : #14161a;
    out property <color> text-muted: dark ? #959ba6 : #5d636e;
    out property <color> text-faint: dark ? #6b717c : #8a909a;
    out property <color> accent: dark ? #4d8dff : #2f6feb;
    out property <color> accent-hover: dark ? #63a0ff : #255fd0;
    out property <color> accent-soft: dark ? #4d8dff22 : #2f6feb18;
    out property <color> on-accent: #ffffff;
    out property <color> success: dark ? #3fcf8e : #18a058;
    out property <color> warning: dark ? #e8b44a : #b7791f;
    out property <color> danger: dark ? #f0565b : #d93036;
    out property <color> focus: dark ? #7aa9ff : #2f6feb;
    out property <color> scrim: dark ? #000000aa : #0f172a66;

    out property <length> radius-s: 6px;
    out property <length> radius-m: 10px;
    out property <length> radius-l: 14px;

    out property <length> font-xs: 11px;
    out property <length> font-s: 12px;
    out property <length> font-m: 13px;
    out property <length> font-l: 15px;
    out property <length> font-xl: 20px;
    out property <length> font-xxl: 26px;

    out property <duration> fast: animations ? 120ms : 0ms;
    out property <duration> normal: animations ? 200ms : 0ms;
}

// Vector icons drawn on a 24×24 grid (original artwork, stroke style).
